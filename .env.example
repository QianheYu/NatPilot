# NatPilot deployment environment
# Copy to .env and adjust. Never commit real credentials.

# Initial administrator (created on first start when no user exists).
NATPILOT_ADMIN_USER=admin
NATPILOT_ADMIN_PASSWORD=change-me-now

# Server
NATPILOT_HOST=0.0.0.0
NATPILOT_PORT=8787
NATPILOT_AUTH=true
NATPILOT_LOG_LEVEL=info
NATPILOT_LOG_FORMAT=text

# Data
NATPILOT_DATA_DIR=/var/lib/natpilot
# NATPILOT_DB=/var/lib/natpilot/natpilot.db
