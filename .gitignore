# Build artifacts
/bin/
/dist/
*.exe
*.exe~
*.out
*.test

# Local runtime data (any data-* scratch directory the CLI or tests create)
/data/
/data-*/
*.db
*.db-wal
*.db-shm
session.key
natpilot.yaml.local

# Local Go module/build caches (dependencies are pinned by go.sum instead).
/.gocache/

# Frontend
/frontend/node_modules/
# Ignore the built bundle but keep the placeholder: go:embed needs at least one
# file on a fresh clone. The pattern must be dist/* (not dist/) — git does not
# descend into an ignored directory, so a negated file inside it would never be
# re-included.
/internal/webui/dist/*
!/internal/webui/dist/placeholder.html

# Desktop edition (Electron)
/desktop/node_modules/
/desktop/release/
# desktop/build/icon.png is generated by `npm run icons` and is tracked on
# purpose: electron-builder derives the .ico/.icns from it.

# Editor and OS noise
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log

# Sandbox leftovers from automated fix sessions — never part of the project.
internal/api/.write-probe.tmp
internal/webui/dist/.probe-write.txt

# Secrets
.env
